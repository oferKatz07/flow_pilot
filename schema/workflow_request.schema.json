{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsequeue.dev/schema/workflow.json",
  "title": "Workflow Submission",
  "type": "object",

  "required": [
    "client_id",
    "request_id",
    "workflow_id",
    "workflow_type",
    "jobs"
  ],

  "properties": {
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },

    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },

    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },

    "workflow_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },

    "created_by": {
      "type": "string",
      "maxLength": 128
    },

    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 5
    },

    "idempotency_key": {
      "type": "string",
      "maxLength": 128
    },

    "failure_policy": {
      "type": "string",
      "enum": [
        "FAIL_FAST",
        "CONTINUE_ON_FAILURE"
      ],
      "default": "FAIL_FAST"
    },

    "retry_policy": {
      "$ref": "#/$defs/retry_policy"
    },

    "retention_policy": {
      "$ref": "#/$defs/retention_policy"
    },

    "workflow_hooks": {
      "$ref": "#/$defs/workflow_hooks"
    },

    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },

    "jobs": {
      "type": "array",
      "minItems": 1,

      "items": {
        "$ref": "#/$defs/job"
      }
    }
  },

  "$defs": {
    "retry_policy": {
      "type": "object",

      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },

        "backoff": {
          "type": "string",
          "enum": [
            "FIXED",
            "LINEAR",
            "EXPONENTIAL"
          ]
        },

        "initial_delay_ms": {
          "type": "integer",
          "minimum": 0
        },

        "max_delay_ms": {
          "type": "integer",
          "minimum": 0
        }
      },

      "required": [
        "max_retries",
        "backoff"
      ]
    },

    "retention_policy": {
      "type": "object",

      "properties": {
        "ttl_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        }
      },

      "required": [
        "ttl_minutes"
      ]
    },

    "workflow_hooks": {
      "type": "object",

      "properties": {
        "on_success": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook_action"
          }
        },

        "on_failure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook_action"
          }
        },

        "on_timeout": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook_action"
          }
        }
      }
    },

    "hook_action": {
      "type": "object",

      "required": [
        "type"
      ],

      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "send_email",
            "webhook",
            "enqueue_workflow"
          ]
        },

        "payload": {
          "type": "object"
        }
      }
    },

    "job": {
      "type": "object",

      "required": [
        "job_id",
        "type",
        "payload"
      ],

      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },

        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },

        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },

        "depends_on": {
          "type": "array",

          "items": {
            "type": "string"
          },

          "uniqueItems": true
        },

        "payload": {
          "type": "object"
        },

        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },

        "retry_policy": {
          "$ref": "#/$defs/retry_policy"
        },

        "compensation": {
          "$ref": "#/$defs/compensation_job"
        },

        "metadata": {
          "type": "object",

          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },

    "compensation_job": {
      "type": "object",

      "required": [
        "type",
        "payload"
      ],

      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },

        "payload": {
          "type": "object"
        },

        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },

        "retry_policy": {
          "$ref": "#/$defs/retry_policy"
        }
      }
    }
  }
}
